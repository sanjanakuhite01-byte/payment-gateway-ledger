<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent gives every module tested, matching library versions -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.sanjana.pay</groupId>
    <artifactId>payment-gateway</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <!-- pom packaging: this file builds nothing itself, it only holds the modules -->
    <packaging>pom</packaging>
    <name>payment-gateway</name>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>common</module>
        <module>ledger-service</module>
        <module>payment-service</module>
        <module>bank-simulator</module>
    </modules>
</project>

<!--/* What each part does, in simple words:-->

<!--        parent (Spring Boot): it picks the library versions for you. All the libraries then work well together, so you don’t get version problems.-->
<!--        packaging pom: this file builds nothing itself. It only holds the list of your services.-->
<!--        java.version 21: all services use Java 21.-->
<!--        modules: the list of your services (common, ledger-service, payment-service, bank-simulator). With one command, Maven builds all of them.-->